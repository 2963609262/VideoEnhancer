<?xml version="1.0" encoding="utf-8"?>
<!-- 保留 PR #7 的安装窗口；实际文件复制由便携载荷完成。 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="VideoEnhancer"
          Manufacturer="VideoEnhancer contributors"
          Version="$(var.ProductVersion)"
          UpgradeCode="519D1BAF-FB98-4C44-8EBE-753B0451ABD5"
          DisableModify="yes"
          DisableRemove="yes"
          Compressed="yes">
    <!-- 默认不在临时目录留下安装日志；排障时仍可用 /log 显式开启。 -->
    <Log Disable="yes" />
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          ThemeFile="VideoEnhancerTheme.xml"
          LocalizationFile="VideoEnhancerTheme.zh-CN.wxl"
          LicenseFile="..\Package\InstallerNotice.rtf"
          ShowVersion="yes"
          SuppressOptionsUI="no" />
    </BootstrapperApplication>

    <!-- 没有默认目录；用户必须在窗口中选择 3FUI 根目录。 -->
    <Variable Name="InstallFolder"
              Type="string"
              Value=""
              bal:Overridable="yes" />

    <Chain>
      <!-- 安装载荷仅在执行期间缓存，流程结束后移除，避免长期占用 Package Cache。 -->
      <ExePackage Id="PortablePlugin"
                  SourceFile="$(var.PortablePayloadPath)"
                  Compressed="yes"
                  PerMachine="no"
                  Permanent="yes"
                  Cache="remove"
                  DetectCondition="0"
                  Vital="yes"
                  InstallArguments='--install-folder "[InstallFolder]" --quiet' />
    </Chain>
  </Bundle>
</Wix>
